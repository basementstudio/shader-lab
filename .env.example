# ============================================
# Shader Lab - Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values
# Run: cp .env.example .env.local
#
# The editor works with NO env vars set. Everything below is optional.
# The community showcase stays hidden until DATABASE_URL is present, so a
# fresh clone gets a fully working editor rather than broken buttons.
# ============================================


# ============================================
# CORE
# ============================================

# Base URL for your site (used for SEO, canonical URLs, etc.)
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Facebook app id, emitted as the fb:app_id meta tag
# Draft mode secret for preview functionality
# Generate a random string: openssl rand -base64 32
DRAFT_MODE_TOKEN=""


# ============================================
# SANITY CMS (Optional)
# Headless CMS with visual editing
# Get credentials: https://sanity.io/manage
# Docs: https://www.sanity.io/docs
# ============================================

# Required for Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_READ_TOKEN=""

# Optional - for server-side mutations and visual editing
# SANITY_PRIVATE_TOKEN=""

# Optional - API version (defaults to 2024-03-15)
# NEXT_PUBLIC_SANITY_API_VERSION="2024-03-15"


# ============================================
# SHOPIFY (Optional)
# E-commerce platform with cart and checkout
# Get credentials: https://shopify.dev/docs/storefronts/headless
# ============================================

# Required for Shopify
# SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

# Optional - for revalidation webhooks
# SHOPIFY_REVALIDATION_SECRET=""

# Optional - for customer accounts
# SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
# SHOPIFY_CUSTOMER_ACCOUNT_API_URL=""

# ============================================
# SENTRY (Optional)
# Error monitoring + tracing across browser, Node and Edge
# Get the DSN: https://sentry.io -> Project Settings -> Client Keys (DSN)
# ============================================

# Same DSN for browser, Node and Edge. Without it the SDK initializes and
# sends nothing, so the app runs fine unconfigured.
NEXT_PUBLIC_SENTRY_DSN=""

# Optional trace sampling override, 0-1. Defaults to 0.05 in production and 0
# everywhere else. Out-of-range values fall back to the default.
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=""

# Build-time only - uploads source maps so production stack traces are readable.
# Without it the build silently skips the upload. org/project live in next.config.ts.
# Create at: https://sentry.io/orgredirect/organizations/:orgslug/settings/auth-tokens/
SENTRY_AUTH_TOKEN=""


# ============================================
# ANALYTICS (Optional)
# ============================================

# Google Analytics
# NEXT_PUBLIC_GOOGLE_ANALYTICS=""

# Google Tag Manager
# NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=""

# Facebook
# NEXT_PUBLIC_FACEBOOK_APP_ID=""


# ============================================
# COMMUNITY SHOWCASE (Optional)
# Published scenes, auth, likes, remix lineage.
# Leave DATABASE_URL empty to disable the whole feature.
# ============================================

# Neon Postgres, pooled connection string
# https://console.neon.tech -> project -> Connection string (Pooled)
# Set COMMUNITY_DATABASE_URL when a platform integration owns DATABASE_URL and
# keeps overwriting it (the Neon Vercel integration does this per deployment).
# It takes precedence, so the integration can manage DATABASE_URL freely.
COMMUNITY_DATABASE_URL=""
DATABASE_URL=""

# Managed Better Auth (hosted by Neon; it owns the neon_auth schema)
# Auth URL: Neon Console -> project -> your branch -> Auth. It is per branch.
# Same precedence trick as COMMUNITY_DATABASE_URL above.
COMMUNITY_NEON_AUTH_BASE_URL=""
NEON_AUTH_BASE_URL=""

# Signs the session cookie. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""

# OAuth provider credentials are NOT env vars. Enter them in the Neon Console
# on the matching branch: Auth -> OAuth providers. Google works with Neon's
# shared credentials in development; GitHub needs your own OAuth app whose
# callback is <NEON_AUTH_BASE_URL>/callback/github.

# Comma-separated emails allowed to take scenes down and read the report queue.
# Deliberately an env allowlist and not a database column: a role flag in
# Postgres is one injection away from self-promotion. Matched against the email
# the OAuth provider verified, not the editable profile handle.
COMMUNITY_ADMIN_EMAILS=""


# ============================================
# CLOUDFLARE (Optional, required to publish media)
# Scene JSON and assets live here. Scope API tokens to the single
# permission listed - do not use a global API key.
# ============================================

CLOUDFLARE_ACCOUNT_ID=""

# R2 holds the scene .lab JSON, audio and 3D models.
# S3-compatible credentials: R2 -> Manage API tokens.
#
# IMPORTANT: the bucket needs a CORS policy allowing GET from your app
# origin. Without it, cross-origin textures taint the canvas and both
# thumbnail capture and image/video export fail with a SecurityError.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# With or without the scheme; it is normalised before use.
NEXT_PUBLIC_R2_PUBLIC_HOST=""

# Cloudflare Images serves scene thumbnails and image assets.
# Token permission: Account -> Cloudflare Images -> Edit
# Note: Images rejects anything over 10 MB or 100 megapixels, so large
# uploads are re-encoded client-side before they get here.
CF_IMAGES_TOKEN=""
NEXT_PUBLIC_CF_IMAGES_HOST="imagedelivery.net"
# Shown on the Images dashboard once Images is enabled. This is NOT your account
# id; it is the first path segment of every delivery URL:
#   https://imagedelivery.net/<ACCOUNT_HASH>/<image_id>/<variant>
NEXT_PUBLIC_CF_IMAGES_ACCOUNT_HASH=""

# Cloudflare Stream transcodes uploaded video.
# Token permission: Account -> Stream -> Edit
#
# IMPORTANT: enable MP4 Downloads on the Stream account. Stream's default
# delivery is an HLS manifest, which the WebGPU video texture path cannot
# consume outside Safari; we need the direct .../downloads/default.mp4 URL.
CF_STREAM_TOKEN=""
CF_STREAM_WEBHOOK_SECRET=""


# ============================================
# ABUSE PREVENTION (Optional)
# ============================================

# Cloudflare Turnstile, checked server-side on publish
# https://dash.cloudflare.com -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""


# ============================================
# ASSET ORIGIN ALLOWLIST
# ============================================

# Extra hosts a .lab file is allowed to reference assets from, comma
# separated. The Cloudflare hosts above are trusted automatically; this is
# an escape hatch for local testing.
#
# Every remote asset URL in an imported .lab is checked against this list
# before it is loaded. Without the check, a hand-crafted project file
# dropped on the canvas becomes an arbitrary-outbound-request primitive.
# Loopback is never implicitly trusted - list "localhost" to allow it.
#
# This list also feeds images.remotePatterns, so every host allowed here can
# be served through next/image. The two are derived from the same value on
# purpose: a host that passes the asset check but is missing from
# remotePatterns renders a broken thumbnail in production and throws
# "Invalid src prop" in development.
# NEXT_PUBLIC_COMMUNITY_ASSET_HOSTS=""

# Set to "1" to expose the community deployment diagnostics endpoints:
# /api/community/status (which capabilities resolved, and from which env var)
# and /api/community/auth-debug (which Neon auth cookies arrived). Both return
# 404 while this is unset.
#
# Keep it unset in production. status reports the resolved database and auth
# hostnames plus which secrets are present, which is deployment topology that
# does not belong on a public endpoint. Turn it on to diagnose a deploy where
# community is unexpectedly off, then turn it back off - a moderator check
# would not work here, since broken auth is the case you need it for.
# COMMUNITY_AUTH_TRACE="1"
