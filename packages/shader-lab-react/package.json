{
  "name": "@basementstudio/shader-lab",
  "version": "3.0.1",
  "description": "Portable React runtime for Shader Lab exports.",
  "author": "Tobi Moccagatta (https://github.com/git-chad)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "assets"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./fonts.css": "./assets/fonts.css"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/basementstudio/shader-lab"
  },
  "homepage": "https://eng.basement.studio/tools/shader-lab",
  "keywords": [
    "shader",
    "shaders",
    "webgpu",
    "tsl",
    "three",
    "threejs",
    "react",
    "shader-lab",
    "creative-coding"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.183.0"
  },
  "scripts": {
    "build": "node ./scripts/prepare-dist.mjs && bun x tsc -p tsconfig.build.json && node ./scripts/fix-esm-specifiers.mjs",
    "lint": "biome lint src --max-diagnostics=200",
    "prepack": "bun run build",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit"
  }
}
